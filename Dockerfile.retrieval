FROM python:3.12-slim

WORKDIR /srv

COPY requirements.txt .
RUN pip install --no-cache-dir --default-timeout=1200 hayhooks vllm-haystack qdrant-haystack
# --default-timeout=1200 in case it doesn't download packages fast enough

COPY pipeline_wrappers/RAG-Test ./pipeline_wrappers/RAG-Test
# COPY pipeline_wrappers/RAG-QWEN ./pipeline_wrappers/RAG-QWEN

EXPOSE 1416

# Hayhooks auto-discovers and deploys every wrapper under this directory at startup
ENV HAYHOOKS_PIPELINES_DIR=/srv/pipeline_wrappers
ENV HAYHOOKS_HOST=0.0.0.0
ENV HAYHOOKS_PORT=1416

CMD ["hayhooks", "run"]