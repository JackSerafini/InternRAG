FROM python:3.12-slim

WORKDIR /srv

# System deps that docling/some haystack integrations need for PDF/doc parsing
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1 \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir --default-timeout=1200 -r requirements.txt
# --default-timeout=1200 in case it doesn't download packages fast enough

COPY app/ ./app/

EXPOSE 8001

CMD ["uvicorn", "app.indexing:app", "--host", "0.0.0.0", "--port", "8001"]