FROM python:3.12-slim

WORKDIR /srv

# System deps that docling/some haystack integrations need for PDF/doc parsing
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1 \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir --default-timeout=1200 hayhooks vllm-haystack qdrant-haystack docling-haystack
# --default-timeout=1200 in case it doesn't download packages fast enough

COPY pipeline_wrappers/indexing/ ./pipeline_wrappers/indexing/

EXPOSE 1416
 
ENV HAYHOOKS_PIPELINES_DIR=/srv/pipeline_wrappers
ENV HAYHOOKS_HOST=0.0.0.0
ENV HAYHOOKS_PORT=1416
 
CMD ["hayhooks", "run"]